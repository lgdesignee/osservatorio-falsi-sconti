{
 "title": "Osservatorio dei falsi sconti — Radar Volantini by Prezzi in Vista",
 "description": "Every month: how many electronics and home-appliance offers presented as discounts in Italian flyers cost less in an online shop, how many cost about the same, and how many cost less in the flyer. Italy only.",
 "license": "CC BY 4.0 — cite Prezzi in Vista and link to the page",
 "page": "https://www.prezzinvista.it/falsi-sconti/",
 "method": "https://www.prezzinvista.it/falsi-sconti/#metodo",
 "updated_at": "2026-11-13T02:20:08.518Z",
 "definitions": {
  "discounted_offers_compared": "flyer offers with a printed previous price and a printed model code, compared with an online offer (new items only) whose title carries the same model code. Recomputed on 12 October 2026 with this stricter rule: offers identified by name only are no longer counted",
  "cheaper_online": "the saved online price is at least 3% below the flyer price",
  "cheaper_in_flyer": "the saved online price is at least 3% above the flyer price",
  "similar_price": "the saved online price is within 3% of the flyer price",
  "distinct_products": "the same model printed in the flyers of several chains (often Trony, Freeshop and Leonardelli share a flyer) counts once",
  "certified_fake_discount": "at least two different online shops sell it at least 5% (and at least 5 €) below the flyer price. It does not say that the printed previous price is untrue: that is not checked",
  "certified_real_discount": "at least two online shops were compared and the cheapest one is at least 5% above the flyer price",
  "funnel": "how many flyer offers enter the count: all offers with a printed previous price, those with a printed model code, those found online with the same code, and those left after removing regional duplicates of the same offer and prices that hold only with another purchase (3 for 2, second item discounted, trade-in, \"from\") or that are below half of the lowest online price. Both rules, and the one that Lenovo family codes (e.g. 15IWC11) are not model codes, apply since 9 November 2026 to every month",
  "median_saving_online_percent": "median of the online discount among the offers that cost less online"
 },
